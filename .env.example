# Caelos — environment configuration
# Copy this file to `.env.local` and fill in your own values. Never commit `.env.local`.

# The browser holds NO credentials. Console -> ops calls go through the same-origin /ops proxy
# (functions/ops/[[path]].ts); the bearer is the Pages secret CONSOLE_OPS_BEARER.
# To run `vite dev` against the real backend: export CONSOLE_OPS_BEARER in your shell (not in a VITE_ var),
# then set VITE_OPS_PROXY=1 below. Unset = in-memory mock.
# VITE_OPS_PROXY=1

# Value shown first in owner pickers; pinned in .env.production / .env.development, override per-build.
VITE_HUMAN_OWNER=daniel

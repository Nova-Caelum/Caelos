# Caelos — environment configuration
# Copy this file to `.env.local` and fill in your own values. Never commit `.env.local`.

# Base URL of the Nova Caelum ops backend (FastAPI + MCP surface). No trailing slash.
# Hosted deployment default:
VITE_API_BASE_URL=https://nova-caelum-ops-production.up.railway.app

# Bearer token issued by the ops backend for your tenant. Contact daniel@novacaelum.com
# to request a token during the pre-alpha invite-only phase.
VITE_BEARER_TOKEN=your-bearer-token-here

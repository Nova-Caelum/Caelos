{
  "name": "@nova-caelum/ui-react19",
  "version": "0.1.0-react19.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "DESIGN-REFERENCES.md",
    "VALIDATION.md",
    "SOURCE-OWNERSHIP.md",
    "CURRENT-DESIGN-DECISIONS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./styles.css": "./dist/styles.css",
    "./recipes": {
      "types": "./dist/host-recipes.d.ts",
      "import": "./dist/host-recipes.js"
    }
  },
  "scripts": {
    "build": "panda codegen && tsc --noEmit && tsup && panda cssgen --outfile dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "motion": "^12.42.2"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-select": "2.1.6",
    "lucide-react": "0.487.0",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-popover": "1.1.6",
    "sonner": "2.0.3"
  },
  "devDependencies": {
    "@pandacss/dev": "1.12.1",
    "typescript": "5.9.3",
    "tsup": "8.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "1.62.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
